<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>ブロックぼうけん すごろく</title><style>:root{
  --ink:#f6f4eb; --dark:#0c1115; --stone:#2f373d; --gold:#ffd24a;
  --green:#56c84b; --red:#ef5b4c; --blue:#56b7ff; --cyan:#47e7e0; --purple:#b15cff;
  --shadow:0 12px 34px rgba(0,0,0,.42);
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#0a0e11;color:var(--ink);font-family:"Yu Gothic","Hiragino Kaku Gothic ProN",system-ui,sans-serif;overflow-x:hidden}
button,select{font:inherit} button{cursor:pointer} img{max-width:100%}
.pixel{font-family:Impact,"Arial Black","Yu Gothic",sans-serif;letter-spacing:.03em}
#app{min-height:100vh;background:#0a0e11}

/* setup */
.setup{min-height:100vh;display:grid;place-items:center;padding:18px;background:linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.55)),url('assets/plains_bg.jpg') center/cover fixed}
.setup-card{width:min(980px,96vw);background:rgba(17,22,25,.91);border:4px solid #647178;box-shadow:var(--shadow);border-radius:20px;overflow:hidden;backdrop-filter:blur(6px)}
.setup-title{padding:22px 24px;background:linear-gradient(180deg,#5c963c,#315d25);border-bottom:4px solid #1f301d;text-align:center;text-shadow:0 4px 0 #25351d}
.setup-title h1{font-size:clamp(32px,7vw,68px);margin:0}.setup-title p{margin:6px 0 0;font-weight:800}
.setup-body{padding:18px;display:grid;gap:16px}.choice-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.choice-title{font-weight:900;font-size:18px;margin:4px 0 8px;color:#ffe877}
.choice-card{border:3px solid #596267;background:#222a2e;color:#fff;border-radius:14px;padding:12px;display:flex;gap:12px;align-items:center;min-height:82px;transition:.15s}.choice-card.selected{border-color:#f5d34d;background:#3b442e;transform:translateY(-2px)}.choice-card img{width:72px;height:72px;object-fit:contain;border-radius:10px}
.big-start{border:0;border-bottom:6px solid #7f271e;background:linear-gradient(#ffb14a,#ef5e32);color:white;text-shadow:0 3px 0 #70231c;padding:15px 22px;border-radius:14px;font-size:24px;font-weight:1000}.note{font-size:13px;color:#d5d5c8;line-height:1.6}

/* game shell */
.game{min-height:100vh;display:flex;flex-direction:column;background:#0d1114}
.topbar{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:10px;padding:8px 10px;background:#171c1f;border-bottom:3px solid #3f494f;position:sticky;top:0;z-index:40}
.player-pill{display:flex;gap:8px;align-items:center;background:#252c30;border:2px solid #49545a;border-radius:12px;padding:6px 8px;min-width:0}.player-pill.active{border-color:#ffd34d;box-shadow:0 0 0 2px rgba(255,211,77,.18)}.player-pill img{width:44px;height:44px;object-fit:contain}.pill-text{min-width:0}.pill-name{font-weight:1000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pill-pos{font-size:12px;color:#cfd3d5}.pill-items{font-size:11px;color:#ffe089}.turnbadge{text-align:center;font-weight:1000;color:#ffe36b}.turnbadge small{display:block;color:#cfd3d5;font-weight:700}
